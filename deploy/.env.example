# Copy to .env (next to compose.yaml) and adjust for your server.

# User/group the container runs as - must own ./data (check with `id -u` and `id -g`)
PUID=1000
PGID=1000

# Port on the server for http://<server-ip>:<port> and Nginx Proxy Manager
FB_PORT=8765

# Timezone used for diary dates and the "posted today" check
TZ=Europe/London
