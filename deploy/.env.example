# Copy to .env (next to compose.yaml) and adjust for your server.

# User/group the container runs as - must own ./data (check with `id -u` and `id -g`)
PUID=1000
PGID=1000

# Port on the server for http://<server-ip>:<port> and Nginx Proxy Manager
FB_PORT=8765

# Address the port is published on. 0.0.0.0 = whole LAN. When a reverse
# proxy on this same host is in front (with FB_TRUST_PROXY=1 below), set
# FB_BIND=127.0.0.1 so only the proxy can reach the app. If the proxy is
# another container, put both on a shared Docker network (e.g. add
# `networks: [proxy]` to the service, with `proxy: {external: true}`
# at the bottom), point the proxy at http://family-blogger:8765 and
# remove the `ports:` entry instead.
FB_BIND=0.0.0.0

# Timezone used for diary dates and the "posted today" check
TZ=Europe/London

# Image version to run with compose.ghcr.yaml. Pin a release tag from
# https://github.com/TimJ425/family-blogger/releases, such as 1.0
# (newest 1.0.x) or 1.0.2. Avoid "latest" so updates are deliberate.
# Replace the placeholder with the release you want.
FB_TAG=1.0

# Behind a reverse proxy? List the proxy's address so each phone or
# tablet is recognised separately for log-in pauses. Comma-separated
# IPs or CIDRs. Examples:
#   proxy in a container on a shared Docker network: that network's
#     subnet, e.g. FB_TRUSTED_PROXIES=172.18.0.0/16
#   proxy on another machine: its IP, e.g. FB_TRUSTED_PROXIES=192.168.1.5
# Leave empty if there is no proxy.
FB_TRUSTED_PROXIES=

# Older setting: set to 1 to trust whatever connects directly. ONLY safe
# together with FB_BIND=127.0.0.1 (proxy running on the host itself).
FB_TRUST_PROXY=0

# Set to 1 when the site is served over HTTPS (cookies get "Secure")
FB_COOKIE_SECURE=0

# Advanced: data folder inside the container. Compose mounts ./data at
# /data, so leave this alone unless you know you need to change it.
# (Compose does not pass this through; it is set in the image.)
# FB_INSTANCE_DIR=/data
