# Local Python environment
.venv/

# App data: databases, uploads, secret keys (personal - never commit)
instance/
data/
deploy/data/
backups/
deploy/backups/
graphify-out/

# Environment files (keep the example)
.env
*.env
!.env.example

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Logs and OS / editor clutter
*.log
.DS_Store
.idea/
.vscode/

# Restore / migration safety copies (contain personal data)
data.before-restore-*/
deploy/data.before-restore-*/
**/data.before-restore-*/
*.pre-migration-*.db
